* text=auto eol=lf
*.unity text
*.prefab text
*.mat text
*.meta text
# Unity emits trailing spaces for empty YAML values; preserve its serialization.
*.unity whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.meta whitespace=-blank-at-eol
*.cs text
*.shader text
*.dll binary
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
# Preserve vendor resources and significant spaces in locale phrases.
"Assets/TextMesh Pro/**" -whitespace
Assets/CircuitLab/Localization/FontSources/*-OFL.txt -whitespace
Assets/CircuitLab/Localization/*.tsv whitespace=-blank-at-eol
Assets/CircuitLab/Scenes/CircuitLab.unity filter=lfs diff=lfs merge=lfs -text
